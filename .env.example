# 应用显示名称。
SCHOLARFLOW_APP_NAME=ScholarFlow
# 运行环境：development、test 或 production。
SCHOLARFLOW_ENVIRONMENT=development
# 后端 API 路由前缀。
SCHOLARFLOW_API_V1_PREFIX=/api/v1
# SQLite 数据库连接地址；请勿填写真实生产数据库凭据。
SCHOLARFLOW_DATABASE_URL=sqlite:///./data/scholarflow.db
# 日志文件目录。
SCHOLARFLOW_LOG_DIR=logs
# 控制台与文件日志级别。
SCHOLARFLOW_LOG_LEVEL=INFO

# 是否启用可降级的 Redis 短期存储；未部署 Redis 时保持 false。
SCHOLARFLOW_REDIS_ENABLED=false
# Redis 连接地址；仅在启用时使用，不应包含真实密码。
SCHOLARFLOW_REDIS_URL=redis://localhost:6379/0
# Redis 键前缀，隔离同一 Redis 实例中的其他应用数据。
SCHOLARFLOW_REDIS_KEY_PREFIX=scholarflow
# Redis 连接与命令的单次超时时间（秒）。
SCHOLARFLOW_REDIS_SOCKET_TIMEOUT_SECONDS=2
# 学术来源搜索结果缓存时长（秒）；默认四小时，过期后自动回源。
SCHOLARFLOW_REDIS_SOURCE_SEARCH_CACHE_TTL_SECONDS=14400

# OpenAlex REST API 地址；保持 HTTPS，通常无需修改。
SCHOLARFLOW_OPENALEX_API_BASE_URL=https://api.openalex.org
# OpenAlex API 密钥；请在本地 .env 中填写，禁止提交真实值。
SCHOLARFLOW_OPENALEX_API_KEY=
# OpenAlex 单次请求超时时间（秒）。
SCHOLARFLOW_OPENALEX_TIMEOUT_SECONDS=10

# arXiv Atom API 地址；保持 HTTPS，通常无需修改。
SCHOLARFLOW_ARXIV_API_BASE_URL=https://export.arxiv.org/api
# arXiv 单次请求超时时间（秒）。
SCHOLARFLOW_ARXIV_TIMEOUT_SECONDS=15
# arXiv 来源级每秒请求次数上限；默认 1/3，即连续请求间隔至少三秒。
SCHOLARFLOW_ARXIV_REQUESTS_PER_SECOND=0.3333333333333333

# DBLP 出版物搜索 API 地址；保持 HTTPS，通常无需修改。
SCHOLARFLOW_DBLP_API_BASE_URL=https://dblp.org/search/publ
# DBLP 单次请求超时时间（秒）。
SCHOLARFLOW_DBLP_TIMEOUT_SECONDS=10
# DBLP 来源级每秒请求次数上限；默认使用保守的每秒一次。
SCHOLARFLOW_DBLP_REQUESTS_PER_SECOND=1

# Tavily 补充网页发现 API 地址；保持 HTTPS，通常无需修改。
SCHOLARFLOW_TAVILY_API_BASE_URL=https://api.tavily.com
# Tavily API 密钥；请在本地 .env 中填写，禁止提交真实值。
SCHOLARFLOW_TAVILY_API_KEY=
# Tavily 单次请求超时时间（秒）。
SCHOLARFLOW_TAVILY_TIMEOUT_SECONDS=10
# Tavily 来源级每秒请求次数上限。
SCHOLARFLOW_TAVILY_REQUESTS_PER_SECOND=1
# Tavily 单次补充发现的最大网页结果数。
SCHOLARFLOW_TAVILY_MAX_RESULTS=5

# Semantic Scholar Academic Graph API 地址；保持 HTTPS，通常无需修改。
SCHOLARFLOW_SEMANTIC_SCHOLAR_API_BASE_URL=https://api.semanticscholar.org/graph/v1
# Semantic Scholar API 密钥；未配置时使用匿名访问，禁止提交真实值。
SCHOLARFLOW_SEMANTIC_SCHOLAR_API_KEY=
# Semantic Scholar 是否进入动态路由；已获批 Key 时保持 true，并遵守每秒一次限制。
SCHOLARFLOW_SEMANTIC_SCHOLAR_ENABLED=true
# Semantic Scholar 单次请求超时时间（秒）。
SCHOLARFLOW_SEMANTIC_SCHOLAR_TIMEOUT_SECONDS=10
# Semantic Scholar 来源级每秒请求次数上限；带 Key 的初始基线为 1。
SCHOLARFLOW_SEMANTIC_SCHOLAR_REQUESTS_PER_SECOND=1
# Semantic Scholar 遇到限流时的最大重试次数；默认 0，单源失败后直接降级以节省 API 调用。
SCHOLARFLOW_SEMANTIC_SCHOLAR_MAX_RETRIES=0

# DeepSeek OpenAI 兼容 API 地址；保持 HTTPS，通常无需修改。
SCHOLARFLOW_DEEPSEEK_API_BASE_URL=https://api.deepseek.com
# DeepSeek API 密钥；请在本地 .env 中填写，禁止提交真实值。
SCHOLARFLOW_DEEPSEEK_API_KEY=
# LLM 精排默认模型。
SCHOLARFLOW_DEEPSEEK_MODEL=deepseek-v4-flash
# LLM 批量核验单次请求超时时间（秒）。
SCHOLARFLOW_DEEPSEEK_TIMEOUT_SECONDS=60
# LLM 结构化核验最大输出 Token 数。
SCHOLARFLOW_DEEPSEEK_MAX_OUTPUT_TOKENS=12000
# 每个学术来源的候选召回上限。
SCHOLARFLOW_ACADEMIC_SOURCE_RECALL_LIMIT=50
# 最终推荐最低 LLM 相关度。
SCHOLARFLOW_LLM_MINIMUM_RELEVANCE_SCORE=0.2
