# 应用显示名称。
SCHOLARFLOW_APP_NAME=ScholarFlow
# 运行环境：development、test 或 production。
SCHOLARFLOW_ENVIRONMENT=development
# 后端 API 路由前缀。
SCHOLARFLOW_API_V1_PREFIX=/api/v1
# SQLite 数据库连接地址；请勿填写真实生产数据库凭据。
SCHOLARFLOW_DATABASE_URL=sqlite:///./data/scholarflow.db
# 日志文件目录。
SCHOLARFLOW_LOG_DIR=logs
# 控制台与文件日志级别。
SCHOLARFLOW_LOG_LEVEL=INFO
